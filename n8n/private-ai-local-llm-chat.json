{
  "name": "Private AI - Local Ollama Chat",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "private-ai-chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1",
      "name": "Chat Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -500,
        0
      ],
      "webhookId": "private-ai-chat-demo"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json; const message = String(body.message ?? '').trim(); if (!message) throw new Error('Provide message in JSON body'); return [{json:{message}}];"
      },
      "id": "2",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -250,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'llama3.2', prompt: 'You are a private local AI assistant. Answer clearly and do not claim external actions. User: ' + $json.message, stream: false } }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "3",
      "name": "Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, answer: $json.response ?? 'No response' } }}",
        "options": {}
      },
      "id": "4",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        250,
        0
      ]
    }
  ],
  "connections": {
    "Chat Webhook": {
      "main": [
        [
          {
            "node": "Validate Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Input": {
      "main": [
        [
          {
            "node": "Ollama",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ollama": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
